# ====================================================================
# MEGA.nz Credentials & Configuration
# ====================================================================

# MEGA Account Credentials (required)
MEGA_EMAIL=your_email@example.com
MEGA_PASSWORD=your_mega_password

# Target folder path on MEGA.nz to recursively scan (default: /)
# Example: /Photos/SubFolder or /
TARGET_PATH=/Photos/SubFolder

# Execution mode: "once" (default) or "cron"
RUN_MODE=once

# Cron expression for recurring sync (default: every hour at minute 0)
CRON_SCHEDULE="0 * * * *"

# Run an immediate sync when starting in cron mode (true/false)
RUN_ON_START=false

# ====================================================================
# AVIF Conversion Settings
# ====================================================================

# AV1 Encoder backend: aom (recommended for low RAM), svt, or rav1e
AVIF_CODEC=aom

# Encoder speed 0-10 (default: 8)
AVIF_SPEED=8

# Quality level 0-100 (default: 85)
AVIF_QUALITY=85

# Number of parallel jobs for convert_to_avif (default: 1 for low VPS resource usage)
AVIF_JOBS=1

# ====================================================================
# System Paths & Logging
# ====================================================================

# Base temporary directory for downloading files before conversion
TEMP_BASE_DIR=/tmp/mega

# Log file path for teeing conversion output (expands ~ on Unix)
LOG_FILE=~/ws/conversion.log

# Path to convert_to_avif.sh wrapper script (auto-detected if omitted)
# CONVERT_SCRIPT_PATH=../convert_to_avif/convert_to_avif.sh
